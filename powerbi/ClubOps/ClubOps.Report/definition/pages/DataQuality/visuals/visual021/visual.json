{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "visual021",
  "position": {
    "x": 20,
    "y": 250,
    "width": 450,
    "height": 250,
    "z": 21,
    "tabOrder": 21
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "QA_Issues"
                    }
                  },
                  "Property": "code"
                }
              },
              "queryRef": "QA_Issues.code"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "ClubMatches"
                    }
                  },
                  "Property": "QA Messages"
                }
              },
              "queryRef": "ClubMatches.QA Messages"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'QA messages by category'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
